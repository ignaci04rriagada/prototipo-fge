{
  "name": "prototipo-fge",
  "version": "0.1.0",
  "description": "Prototipo estático para Fundación Gestionar Esperanzas",
  "main": "index.php",
  "scripts": {
    "dev": "sass --watch src/scss/style.scss:assets/css/style.css --style=expanded",
    "build": "sass src/scss/style.scss:assets/css/style.css --style=compressed",
    "lint:js": "eslint src/js/**/*.js",
    "format": "prettier --write \"**/*.{php,html,scss,json,js}\""
  },
  "keywords": ["design-system", "atomic-design", "bem", "sass", "mamp"],
  "author": "Ignacio Arriagada",
  "license": "MIT",
  "devDependencies": {
    "bootstrap": "^5.3.3",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.5",
    "sass": "^1.72.0"
  }
}